---
import { defaultLocale, homeUrl, localeInfo, locales } from "@/i18n/locales";
import Base from "@/layouts/Base.astro";
import PromptLine from "@/components/PromptLine.astro";
import { rootRedirectScript } from "@/lib/language/root-redirect";
import { t } from "@/i18n/t";

const lang = defaultLocale;
---

<Base
  alternates={false}
  description={t(lang, "meta.description")}
  lang={lang}
  title={t(lang, "meta.title")}
>
  <Fragment slot="head">
    <script is:inline set:html={rootRedirectScript()} />
  </Fragment>
  <PromptLine command="ls ~/matrix" />
  <main>
    <h1>{t(lang, "redirect.choose")}</h1>
    <ul>
      {locales.map((locale) => (
        <li>
          <a
            href={homeUrl(locale)}
            hreflang={localeInfo[locale].htmlLang}
            lang={localeInfo[locale].htmlLang}
          >
            {localeInfo[locale].label}
          </a>
        </li>
      ))}
    </ul>
  </main>
</Base>

<style>
  /*
   * With JavaScript the page redirects at once, so it stays blank instead of
   * flashing the chooser. If the redirect fails, the page appears after a delay.
   */
  :global(html.js body) {
    visibility: hidden;
    animation: reveal 0s 1.5s forwards;
  }

  @keyframes reveal {
    to {
      visibility: visible;
    }
  }

  main {
    width: 100%;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--page-padding);
  }

  h1 {
    margin-bottom: var(--space-4);
    font-size: var(--text-body);
    font-weight: 500;
  }

  li {
    padding: var(--space-1) 0;
  }
</style>
