---
import { defaultLocale, homeUrl, localeInfo, locales } from "@/i18n/locales";
import Base from "@/layouts/Base.astro";
import PromptLine from "@/components/PromptLine.astro";
import { t } from "@/i18n/t";

const lang = defaultLocale;
---

<Base
  alternates={false}
  description={t(lang, "meta.description")}
  lang={lang}
  title={`Not found · ${t(lang, "meta.title")}`}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>
  <PromptLine command="cat missing-page" />
  <main>
    <h1>404 · no such page</h1>
    <p>That page doesn't exist. Pick a language to start from the home page.</p>
    <ul>
      {locales.map((locale) => (
        <li>
          <a
            href={homeUrl(locale)}
            hreflang={localeInfo[locale].htmlLang}
            lang={localeInfo[locale].htmlLang}
          >
            {localeInfo[locale].label}
          </a>
        </li>
      ))}
    </ul>
  </main>
</Base>

<style>
  main {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    width: 100%;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--page-padding);
  }

  h1 {
    font-size: var(--text-tagline);
    font-weight: 700;
    line-height: 1.3;
  }

  li {
    padding: var(--space-1) 0;
  }
</style>
