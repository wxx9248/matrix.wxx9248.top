---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section {id} class="panel" aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`}>{title}</h2>
  <slot />
</section>

<style>
  .panel {
    position: relative;
    padding: var(--panel-padding);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius);
  }

  /* The title sits in the top border, on the page color to cut it */
  h2 {
    position: absolute;
    top: -0.85em;
    left: var(--space-4);
    padding: 0 var(--space-2);
    background: var(--color-bg-page);
    color: var(--color-text-heading);
    font-size: var(--text-body);
    font-weight: 500;
  }
</style>
